{
  "functions": {
    "api/index.js": { "maxDuration": 60 },
    "server.js": { "maxDuration": 60 }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index.js" },
    { "source": "/seguimiento-interno", "destination": "/server.js" },
    { "source": "/(.*)", "destination": "/server.js" }
  ]
}
